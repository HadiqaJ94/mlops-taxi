# Copy to .env (never commit .env)
MLFLOW_TRACKING_URI=http://localhost:5000
# Protects POST /admin/reload (header X-Admin-Token). Replace it in .env: the API refuses change-me.
# Generate one: uv run python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_TOKEN=change-me
# Grafana admin password (compose default is "admin": set your own)
GRAFANA_ADMIN_PASSWORD=change-me-too
